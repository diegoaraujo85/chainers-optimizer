{
  "name": "chainers-optimizer",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "data:update": "pnpm --filter @chainers/data-pipeline run update",
    "data:verify": "pnpm --filter @chainers/data-pipeline run verify",
    "bench": "pnpm --filter @chainers/core-optimizer run bench",
    "sync:nfts": "pnpm --filter @chainers/onchain-sync run sync",
    "layout:test": "pnpm --filter @chainers/layout-engine run test:visual"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
